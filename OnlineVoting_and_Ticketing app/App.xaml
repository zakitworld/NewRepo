<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OnlineVoting_and_Ticketing_app"
             xmlns:helpers="clr-namespace:OnlineVoting_and_Ticketing_app.Helpers"
             x:Class="OnlineVoting_and_Ticketing_app.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <helpers:UpperCaseConverter x:Key="UpperCaseConverter" />

            <!-- Shadows -->
            <Shadow x:Key="PrimaryShadow" Brush="#8B5CF6" Radius="24" Opacity="0.55" Offset="0,6" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
