<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineVoting_and_Ticketing_app.Views.Polls.PollDetailsPage"
             Title="Poll Details"
             BackgroundColor="{StaticResource Background}">

    <Grid>
        <!-- Background glow -->
        <Ellipse WidthRequest="350" HeightRequest="350" Fill="{StaticResource Primary}" Opacity="0.04"
                 VerticalOptions="Start" HorizontalOptions="End" Margin="0,-100,-100,0"/>

        <ScrollView>
            <VerticalStackLayout Padding="25" Spacing="20">

                <!-- Header Card -->
                <Border Style="{StaticResource Border}" Padding="22">
                    <VerticalStackLayout Spacing="16">

                        <!-- Status + total votes row -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border x:Name="StatusBorder" StrokeShape="RoundRectangle 8" Padding="12,6" StrokeThickness="0">
                                <Label x:Name="StatusLabel" Text="ACTIVE" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                            </Border>
                            <!-- Paid badge -->
                            <Border x:Name="PaidBadge" Grid.Column="1" IsVisible="False"
                                    Background="#20F59E0B" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" Padding="12,6" Margin="10,0,0,0"
                                    HorizontalOptions="Start" VerticalOptions="Center">
                                <Label x:Name="PriceBadgeLabel" Text="GHS 1.00 / vote"
                                       TextColor="#FBBF24" FontSize="12" FontAttributes="Bold"/>
                            </Border>
                            <Label x:Name="VoteCountLabel" Grid.Column="2"
                                   TextColor="{StaticResource TextSecondary}" FontSize="12"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Label x:Name="TitleLabel" Style="{StaticResource Headline}" TextColor="{StaticResource White}"/>
                        <Label x:Name="DescriptionLabel" FontSize="14" LineHeight="1.6"
                               TextColor="{StaticResource TextSecondary}"/>

                        <!-- Creator row -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                    Background="{StaticResource Surface}" StrokeThickness="0">
                                <Label Text="👤" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label x:Name="CreatorLabel" TextColor="{StaticResource White}" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="Poll Creator" TextColor="{StaticResource TextSecondary}" FontSize="11"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Timing row -->
                        <Border Background="#10FFFFFF" Stroke="{StaticResource GlassBorderBrush}"
                                StrokeShape="RoundRectangle 12" Padding="14">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="📅" FontSize="16"/>
                                    <Label x:Name="DurationLabel" TextColor="{StaticResource White}" FontSize="13" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="⏰" FontSize="16"/>
                                    <Label x:Name="TimeRemainingLabel" TextColor="{StaticResource Secondary}"
                                           FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Max votes notice (paid polls) -->
                        <Label x:Name="MaxVotesLabel" IsVisible="False"
                               TextColor="{StaticResource TextSecondary}" FontSize="12"
                               HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Contestant / Option list -->
                <Label x:Name="ContestantsHeader" Text="CONTESTANTS"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}" CharacterSpacing="1"/>
                <VerticalStackLayout x:Name="ContestantsContainer" Spacing="12"/>

                <!-- Voting Panel (active paid poll) -->
                <Border x:Name="VotingPanel" IsVisible="False" Style="{StaticResource Border}" Padding="22">
                    <VerticalStackLayout Spacing="18">

                        <Label x:Name="SelectedLabel" Text="Select a contestant above"
                               FontSize="15" TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"/>

                        <!-- Vote quantity stepper (paid only) -->
                        <Grid x:Name="VoteQuantityRow" IsVisible="False"
                              ColumnDefinitions="56,*,56" ColumnSpacing="0">
                            <Button x:Name="DecreaseBtn" Text="−" FontSize="22"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource White}"
                                    CornerRadius="12" HeightRequest="50"
                                    Clicked="OnDecreaseVotes"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label x:Name="VoteQtyLabel" Text="1" FontSize="28"
                                       FontAttributes="Bold" TextColor="{StaticResource White}"
                                       HorizontalOptions="Center"/>
                                <Label Text="votes" FontSize="11"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <Button x:Name="IncreaseBtn" Grid.Column="2" Text="+" FontSize="22"
                                    BackgroundColor="{StaticResource Surface}"
                                    TextColor="{StaticResource White}"
                                    CornerRadius="12" HeightRequest="50"
                                    Clicked="OnIncreaseVotes"/>
                        </Grid>

                        <!-- Total cost label -->
                        <Label x:Name="TotalCostLabel" IsVisible="False"
                               FontSize="14" TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"/>

                        <Button x:Name="VoteButton" Text="Submit Vote"
                                Style="{StaticResource Button}" HeightRequest="56"
                                IsEnabled="False" Clicked="OnVoteClicked"/>

                        <!-- Verify payment state (shown after Paystack browser opens) -->
                        <Button x:Name="VerifyButton" Text="✓ I've Paid — Verify Payment"
                                IsVisible="False"
                                BackgroundColor="#2010B981" TextColor="#10B981"
                                BorderColor="#4010B981" BorderWidth="1"
                                HeightRequest="50" CornerRadius="15"
                                Clicked="OnVerifyPaymentClicked"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Already voted / closed banner -->
                <Border x:Name="VotedBanner" IsVisible="False" Style="{StaticResource Border}"
                        Background="#10F59E0B" Stroke="#30F59E0B" Padding="18">
                    <HorizontalStackLayout Spacing="14">
                        <Label Text="✓" TextColor="#F59E0B" FontSize="22" VerticalOptions="Center"/>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label x:Name="VotedBannerTitle" Text="Vote Recorded"
                                   TextColor="#FBBF24" FontSize="15" FontAttributes="Bold"/>
                            <Label x:Name="VotedBannerSub"
                                   Text="Thank you for participating!"
                                   TextColor="{StaticResource TextSecondary}" FontSize="12"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Label x:Name="ErrorLabel" TextColor="#F43F5E" FontSize="14"
                       IsVisible="False" HorizontalTextAlignment="Center"/>
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False" IsVisible="False"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
