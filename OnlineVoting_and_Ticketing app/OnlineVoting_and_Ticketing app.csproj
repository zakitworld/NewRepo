<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target Android and iOS only -->
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>OnlineVoting_and_Ticketing_app</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>EventHub</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.eventhub.votingandticketing</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Platform Support -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<!-- Use D8 instead of R8 to avoid duplicate-class errors from mismatched
		     transitive AndroidX Tracing / Tracing-Ktx AAR versions -->
		<AndroidDexTool>d8</AndroidDexTool>
		<UserSecretsId>42170273-ea1d-4478-ac6d-0df2d1ff45f6</UserSecretsId>
	</PropertyGroup>

	<!-- Embed appsettings.json as a resource readable via GetManifestResourceStream -->
	<ItemGroup>
		<EmbeddedResource Include="appsettings.json" />
	</ItemGroup>


	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6366F1" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#6366F1" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

		<!-- SQLite Database -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- ASP.NET Identity -->
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Identity.Core" Version="9.0.0" />

		<!-- MVVM Helpers -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

		<!-- QR Code Generation -->
		<PackageReference Include="QRCoder" Version="1.6.0" />
		<PackageReference Include="SkiaSharp" Version="3.116.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.116.1" />

		<!-- Image Caching: FFImageLoading is deprecated; .NET MAUI 10 Image control
		     has built-in caching via Microsoft.Maui.Controls — no extra package needed -->

		<!-- HTTP Client -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

		<!-- Password Hashing -->
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

		<!-- Configuration -->
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />

		<!-- Structured Logging -->
		<PackageReference Include="Serilog" Version="4.1.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

		<!-- Email: sent via HTTP relay (no SMTP from device; avoids carrier port blocks) -->

		<!-- No third-party QR scanner library supports net10.0-android yet.
		     QRScannerPage uses a manual ticket ID entry as a reliable fallback. -->

		<!-- AppCenter was discontinued by Microsoft in March 2025 and its native Android .so
		     files are not 16 KB page-aligned, causing an immediate linker crash on Android 16
		     (API 36). Removed entirely. -->

		<!-- TOTP / 2FA -->
		<PackageReference Include="Otp.NET" Version="1.4.0" />

		<!-- SQLite Encryption (SQLCipher) — 2.1.10+ has 16 KB page-aligned .so for Android 16 -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
	</ItemGroup>

</Project>
